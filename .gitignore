# runtime-generated user settings (persisted by SettingsScreen)
data/user_settings.json
# card images are regenerable; the app fetches them on demand at runtime
# (CardImageCache) and scripts/fetch_cards.py can bulk-prefetch them
data/images/
# 28MB card database — produced by scripts/fetch_cards.py / the fetch pipeline
data/cards.json
# generated by scripts/make_assets.py (and the fetch pipeline)
data/card_back.png
data/assets/backgrounds/menu_background.png
# stray temp files from CardImageCache downloads
*.tmp

# Third-party rulebook PDF: local reference only, never distributed
*.pdf
__pycache__/
